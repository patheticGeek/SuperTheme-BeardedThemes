[Icon Theme]
Name=Bearded Icons
Comment=Ported from the 'Bearded Icons' VS Code icon theme; overrides folder and common file-type icons, inherits Breeze Dark for everything else
Inherits=breeze-dark,breeze,hicolor
Example=folder

Directories=mimetypes/scalable,places/scalable

[mimetypes/scalable]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes

[places/scalable]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
