[Plymouth Theme]
Name=Bearded Diamond
Description=Boot splash generated to match the 'Bearded Theme Black & Diamond' VS Code theme: near-black background with a cyan diamond mark and spinner.
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/beardeddiamond
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.62
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.62
HorizontalAlignment=.5
VerticalAlignment=.62
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x111418
BackgroundEndColor=0x0c0f11
ProgressBarBackgroundColor=0x3b4654
ProgressBarForegroundColor=0x11b7d4
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
